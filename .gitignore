# Excludes the heavy folders where npm/yarn install your packages
node_modules/
/jspm_packages/
/bower_components/

# React build folder (Creaet React App uses /build, Vite uses /dist)
/build
/dist
/dist-ssr
/out

# Express/Node build outputs (if using TypeScript or Babel compilation)
/lib
/output
/*.tgz

# Server logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node process management and runtime data
pids
*.pid
*.seed
*.pid.lock

# Testing coverage reports
/coverage
/.nyc_output

# Linters and formatters caches
.eslintcache
.stylelintcache
*.tsbuildinfo

# macOS clutter
.DS_Store
.AppleDouble
.LSOverride

# Windows clutter
Thumbs.db
Ehthumbs.db
Desktop.ini

# Visual Studio Code settings
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# WebStorm / IntelliJ / JetBrains IDEs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?